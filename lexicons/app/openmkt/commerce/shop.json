{
  "lexicon": 1,
  "id": "app.openmkt.commerce.shop",
  "defs": {
    "main": {
      "type": "record",
      "key": "self",
      "record": {
        "type": "object",
        "required": ["name", "createdAt"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "maxLength": 3000
          },
          "logo": {
            "type": "blob",
            "accept": ["image/*"],
            "maxSize": 1000000
          },
          "banner": {
            "type": "blob",
            "accept": ["image/*"],
            "maxSize": 1000000
          },
          "website": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000
          },
          "location": {
            "type": "ref",
            "ref": "app.openmkt.commerce.defs#location"
          },
          "policies": {
            "type": "ref",
            "ref": "#policies"
          },
          "handlingTime": {
            "type": "string",
            "maxLength": 100,
            "description": "How long the seller takes to dispatch after an order (e.g. '1-3 business days')"
          },
          "defaultCurrency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "description": "ISO 4217 code this shop normally prices in"
          },
          "shipsTo": {
            "type": "array",
            "items": { "type": "string", "minLength": 2, "maxLength": 2 },
            "maxLength": 250,
            "description": "ISO 3166-1 alpha-2 country codes the shop ships to. Absent means unstated, not worldwide."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "description": "Seller policies. For a shop a buyer has never heard of, on a server they have never heard of, these are the only trust signal available. Each may be a URL or inline text.",
      "properties": {
        "returns": { "type": "string", "maxLength": 3000 },
        "shipping": { "type": "string", "maxLength": 3000 },
        "terms": { "type": "string", "maxLength": 3000 },
        "privacy": { "type": "string", "maxLength": 3000 }
      }
    }
  }
}
